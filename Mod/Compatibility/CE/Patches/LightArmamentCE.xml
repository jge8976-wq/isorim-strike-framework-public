          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/Vehicles.VehicleTurretDef[defName="VTOL_Air_Gun556Air"]/projectile</xpath>
          <value>
            <projectile>Bullet_556x45mmNATO_FMJ</projectile>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/Vehicles.VehicleTurretDef[defName="VTOL_Air_Gun556Air"]/genericAmmo</xpath>
          <value>
            <genericAmmo>false</genericAmmo>
          </value>
        </li>
        <li Class="PatchOperationAddModExtension">
          <xpath>Defs/Vehicles.VehicleTurretDef[defName="VTOL_Air_Gun556Air"]</xpath>
          <value>
            <li Class="Vehicles.CETurretDataDefModExtension">
