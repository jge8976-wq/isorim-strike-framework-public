<Patch>
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/CombatExtended.AmmoSetDef[defName="AmmoSet_556x45mmNATO"]</xpath>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationReplace">
          <xpath>Defs/Vehicles.VehicleTurretDef[defName="VTOL_Air_Gun556Air"]/ammunition</xpath>
          <value>
            <ammunition>
              <thingDefs>
                <li>Ammo_556x45mmNATO_FMJ</li>
                <li>Ammo_556x45mmNATO_AP</li>
                <li>Ammo_556x45mmNATO_HP</li>
                <li>Ammo_556x45mmNATO_Incendiary</li>
                <li>Ammo_556x45mmNATO_HE</li>
                <li>Ammo_556x45mmNATO_Sabot</li>
