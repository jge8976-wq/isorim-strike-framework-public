  <Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
    <defName>VTOL_Air_VVE_Frog_MG762</defName>
    <label>7.62mm machine gun</label>
    <description>Role-specific aircraft equipment. CE keeps its native ammunition and impact damage.</description>
    <turretType>Rotatable</turretType>
    <projectile>VTOL_AirBullet_MG762Projectile</projectile>
    <warmUpTimer>0</warmUpTimer>
    <rotationSpeed>80</rotationSpeed>
    <reloadTimer>3</reloadTimer>
    <magazineCapacity>100</magazineCapacity>
    <chargePerAmmoCount>1</chargePerAmmoCount>
    <genericAmmo>true</genericAmmo>
    <autoSnapTargeting>false</autoSnapTargeting>
    <projectileOffset>1.2</projectileOffset>
    <maxRange>140</maxRange>
    <minRange>0</minRange>
    <shotSound>Shot_AssaultRifle</shotSound>
    <graphicData>
      <texPath>UI/FPSVTOL/ModelIconsR1/Gun762</texPath>
      <graphicClass>Vehicles.Graphic_Turret</graphicClass>
      <drawSize>(0.6,0.6)</drawSize>
    </graphicData>
    <ammunition>
      <thingDefs>
        <li>VTOL_AirAmmo_MG762Round</li>
      </thingDefs>
    </ammunition>
    <fireModes>
      <li>
        <shotsPerBurst>10</shotsPerBurst>
        <ticksBetweenShots>6</ticksBetweenShots>
        <ticksBetweenBursts>6</ticksBetweenBursts>
        <spreadRadius>0</spreadRadius>
        <label>Automatic</label>
        <texPath>UI/Gizmos/FireRate_Single</texPath>
      </li>
    </fireModes>
    <modExtensions>
      <li Class="Isorim.Vtol.WeaponExtension">
        <kind>Gun</kind>
        <aiRange>58</aiRange>
        <raidPoints>220</raidPoints>
        <quickFire>true</quickFire>
        <mountFraction>(-0.55,0.55,0.7)</mountFraction>
        <barrels>1</barrels>
        <barrelRadius>0.07</barrelRadius>
        <barrelLength>0.65</barrelLength>
        <scopeTemplate>MachineGun</scopeTemplate>
        <ceAmmoSet>AmmoSet_762x51mmNATO</ceAmmoSet>
      </li>
    </modExtensions>
    <gizmoIconTexPath>UI/FPSVTOL/ModelIconsR1/Gun762</gizmoIconTexPath>
  </Vehicles.VehicleTurretDef>
