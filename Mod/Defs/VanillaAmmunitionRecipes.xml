<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef>
    <defName>VTOL_Make_VTOL_AirAmmo_MG762Round</defName>
    <label>Manufacture 7.62mm machine gun ammunition</label>
    <jobString>Manufacturing aircraft ammunition.</jobString>
    <workAmount>1200</workAmount>
    <workSkill>Crafting</workSkill>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <recipeUsers>
      <li>VVE_GarageBench</li>
      <li>TableMachining</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Chemfuel</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>Chemfuel</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <VTOL_AirAmmo_MG762Round>100</VTOL_AirAmmo_MG762Round>
    </products>
  </RecipeDef>
