<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ResourceBase">
    <defName>VTOL_AirAmmo_Gun556AirRound</defName>
    <label>5.56x45mm airborne light machine gun ammunition</label>
    <description>Ammunition for the matching aircraft mount. With Combat Extended, use native ammunition of the same caliber.</description>
    <stackLimit>500</stackLimit>
    <projectileWhenLoaded>VTOL_AirBullet_Gun556AirProjectile</projectileWhenLoaded>
    <graphicData>
      <texPath>UI/FPSVTOL/ModelIconsR1/Gun556Air</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>0.012</Mass>
      <MarketValue>1</MarketValue>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>VTOL_AirBullet_Gun556AirProjectile</defName>
    <label>5.56x45mm airborne light machine gun projectile</label>
    <thingClass>Bullet</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>10</damageAmountBase>
      <armorPenetrationBase>0.15</armorPenetrationBase>
      <speed>180</speed>
    </projectile>
  </ThingDef>
  <Vehicles.VehicleTurretDef ParentName="VehicleTurretBase">
    <defName>VTOL_Air_Gun556Air</defName>
    <label>5.56x45mm airborne light machine gun</label>
    <description>Mounts on a compatible aircraft hardpoint. AI attack range: 52 tiles. Raid cost: 160 points.</description>
    <turretType>Rotatable</turretType>
    <projectile>VTOL_AirBullet_Gun556AirProjectile</projectile>
    <warmUpTimer>0</warmUpTimer>
    <rotationSpeed>80</rotationSpeed>
    <reloadTimer>2.6</reloadTimer>
    <magazineCapacity>80</magazineCapacity>
    <chargePerAmmoCount>1</chargePerAmmoCount>
    <genericAmmo>true</genericAmmo>
    <autoSnapTargeting>false</autoSnapTargeting>
    <projectileOffset>1.2</projectileOffset>
    <maxRange>52</maxRange>
    <minRange>0</minRange>
    <shotSound>Shot_AssaultRifle</shotSound>
    <graphicData>
      <texPath>UI/FPSVTOL/ModelIconsR1/Gun556Air</texPath>
      <graphicClass>Vehicles.Graphic_Turret</graphicClass>
      <drawSize>(0.6,0.6)</drawSize>
    </graphicData>
    <ammunition>
      <thingDefs>
        <li>VTOL_AirAmmo_Gun556AirRound</li>
      </thingDefs>
    </ammunition>
    <fireModes>
      <li>
        <shotsPerBurst>9</shotsPerBurst>
        <ticksBetweenShots>4</ticksBetweenShots>
        <ticksBetweenBursts>8</ticksBetweenBursts>
        <spreadRadius>0</spreadRadius>
        <label>Automatic</label>
        <texPath>UI/Gizmos/FireRate_Single</texPath>
      </li>
    </fireModes>
    <modExtensions>
      <li Class="Isorim.Vtol.WeaponExtension">
        <kind>Gun</kind>
        <raidPoints>160</raidPoints>
        <quickFire>true</quickFire>
        <mountFraction>(-0.55,0.55,0.7)</mountFraction>
        <barrels>1</barrels>
        <barrelRadius>0.07</barrelRadius>
        <barrelLength>0.65</barrelLength>
        <scopeTemplate>MachineGun</scopeTemplate>
        <ceAmmoSet>AmmoSet_556x45mmNATO</ceAmmoSet>
        <aiRange>52</aiRange>
      </li>
    </modExtensions>
    <gizmoIconTexPath>UI/FPSVTOL/ModelIconsR1/Gun556Air</gizmoIconTexPath>
  </Vehicles.VehicleTurretDef>
